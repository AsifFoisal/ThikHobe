# Public site URL used for metadata and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Better Auth (server-only). Use the same MongoDB database as the Express API.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=thikhobe
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Must match the Express server's JWT_ISSUER / JWT_AUDIENCE.
JWT_ISSUER=thikhobe
JWT_AUDIENCE=thikhobe-client

# Stripe publishable key (safe to expose to the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe secret key and webhook signing secret live in server/.env only.
