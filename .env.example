# Public site URL used for metadata and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express/general API base URL. Leave empty until the backend is available;
# the UI currently reads its illustrative data from data/ instead.
NEXT_PUBLIC_API_URL=

# Stripe publishable key (safe to expose to the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe server-only key. Never expose this with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional webhook secret for server-side Stripe event verification.
STRIPE_WEBHOOK_SECRET=
